{
  "name": "choose-hideaway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend", "shared"],
  "engines": {"node": ">=22.16.0"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "db:import-legacy": "npm run db:import-legacy --workspace backend",
    "test": "node --experimental-strip-types --test tests/reservations.test.mts tests/database.test.mjs",
    "test:admin": "node --test tests/admin-api.test.mjs"
  },
  "devDependencies": {"@types/node": "22.19.19", "typescript": "5.9.3"}
}
