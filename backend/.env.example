# Leave both Turso variables empty to use local SQLite.
# Auth Token needs read/write permissions and is only used by the backend.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Used only without Turso. Paths are relative to backend/ unless absolute.
DATABASE_PATH=./data/reservations.sqlite
# Extra origins that may call the API directly; same-origin requests always work.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# For first-time setup over HTTPS in production, use a long random token.
# Remove it after creating the admin. Local development needs no setup token.
ADMIN_SETUP_TOKEN=
